# Frontend Deployment Configuration Template
# Copy to .env and set according to deployment environment
# --------------------------------------------------------
# API mode: 'live' or 'mock'
# The checked-in .env uses 'live', so this matches the shipped default.
# Set to 'mock' to run the UI with no backend running.
VITE_API_MODE=live

# Backend Base API URL (set to your deployment server URL)
VITE_API_BASE_URL=http://localhost:8000
