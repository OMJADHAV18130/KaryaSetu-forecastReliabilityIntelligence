# KaryaSetu Backend Configuration Template
# Copy to .env and adjust values as needed for your environment
# ---------------------------------------------

# Server Settings
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# Environment and Logging
ENVIRONMENT=research
DEBUG=false
LOG_LEVEL=INFO

# Machine Learning Model & Artifact Paths
MODEL_PATH=models/xgboost_model/model.json
CALIBRATOR_PATH=models/calibration/calibrator.joblib
SHAP_BACKGROUND_PATH=models/shap/background_data.joblib
FEATURE_SCHEMA_PATH=models/feature_schema.json

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
